#!/bin/sh
get_uci() {
  /sbin/uci -q get "$1"
}

# 从 UCI 读取代理配置，默认代理 192.168.2.1:7890
PROXY_SERVER=$(get_uci k3s.globals.proxy_server || echo "192.168.2.1")
PROXY_PORT=$(get_uci k3s.globals.proxy_port || echo "7890")
HTTP_PROXY="http://${PROXY_SERVER}:${PROXY_PORT}"
HTTPS_PROXY="http://${PROXY_SERVER}:${PROXY_PORT}"

# 配置 NO_PROXY：排除集群内部通信
NODE_IP=$(get_uci k3s.globals.node_ip || echo "192.168.2.2")
NO_PROXY="127.0.0.1,localhost,${NODE_IP},10.42.0.0/16,10.43.0.0/16,.svc,.svc.cluster.local,192.168.2.0/24"

export HTTP_PROXY HTTPS_PROXY NO_PROXY
export http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY" no_proxy="$NO_PROXY"

# 记录实际传递给 k3s 的参数，便于排查
echo "$(date +'%F %T') args: $*" >> /tmp/k3s-wrapper.log

k3s "$@" 2>&1 | logger -t k3s &
PID="$!"

trap "kill $PID; wait $PID" TERM INT QUIT
